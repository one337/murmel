{
  "id": "io.github.one337.murmel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.golang"],
  "command": "murmel",
  "separate-locales": false,
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=network",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/golang/bin",
    "env": {
      "GOFLAGS": "-mod=vendor",
      "GONOSUMCHECK": "*",
      "GONOSUMDB": "*",
      "CGO_ENABLED": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "*.la"
  ],
  "modules": [
    {
      "name": "murmel",
      "buildsystem": "simple",
      "build-commands": [
        "tools/install.sh --prefix /app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build-flatpak",
            "repo",
            "web",
            "dist",
            "build-release",
            "build-srpm",
            "target",
            "assets/screenshots",
            "murmel",
            "murmel-cli"
          ]
        }
      ]
    }
  ]
}
