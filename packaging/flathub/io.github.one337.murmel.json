{
  "id": "io.github.one337.murmel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "command": "murmel",
  "separate-locales": false,
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--socket=pulseaudio",
    "--share=network",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/golang/bin",
    "env": {
      "GOFLAGS": "-mod=vendor",
      "GONOSUMCHECK": "*",
      "GONOSUMDB": "*",
      "CGO_ENABLED": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "*.la"
  ],
  "modules": [
    {
      "name": "murmel",
      "buildsystem": "simple",
      "build-commands": [
        "cat VERSION > build-version",
        "tools/install.sh --prefix /app"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/one337/murmel.git",
          "tag": "v0.4.0",
          "commit": "2d6ac41d2f7d032c863f3eaf8a8c3c66f926740d"
        }
      ]
    }
  ]
}
