{
  "id": "io.github.murmel.Murmel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.golang"],
  "command": "murmel",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=network",
    "--device=dri",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/golang/bin",
    "env": {
      "GOFLAGS": "-mod=vendor",
      "GONOSUMCHECK": "*",
      "GONOSUMDB": "*",
      "CGO_ENABLED": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "*.la"
  ],
  "modules": [
    {
      "name": "murmel",
      "buildsystem": "simple",
      "build-commands": [
        "go build -v -o /app/bin/murmel ./cmd/murmel",
        "install -Dm644 data/io.github.murmel.Murmel.desktop /app/share/applications/io.github.murmel.Murmel.desktop",
        "install -Dm644 packaging/io.github.murmel.Murmel.metainfo.xml /app/share/metainfo/io.github.murmel.Murmel.metainfo.xml",
        "install -Dm644 data/icons/hicolor/256x256/apps/io.github.murmel.Murmel.png /app/share/icons/hicolor/256x256/apps/io.github.murmel.Murmel.png",
        "install -Dm644 data/icons/hicolor/128x128/apps/io.github.murmel.Murmel.png /app/share/icons/hicolor/128x128/apps/io.github.murmel.Murmel.png",
        "install -Dm644 data/icons/hicolor/64x64/apps/io.github.murmel.Murmel.png /app/share/icons/hicolor/64x64/apps/io.github.murmel.Murmel.png",
        "install -Dm644 data/icons/hicolor/48x48/apps/io.github.murmel.Murmel.png /app/share/icons/hicolor/48x48/apps/io.github.murmel.Murmel.png",
        "install -Dm644 data/io.github.murmel.Murmel.gschema.xml /app/share/glib-2.0/schemas/io.github.murmel.Murmel.gschema.xml",
        "install -Dm644 data/io.github.murmel.Murmel.service /app/share/dbus-1/services/io.github.murmel.Murmel.service",
        "glib-compile-schemas /app/share/glib-2.0/schemas/",
        "mkdir -p /app/share/locale"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build-flatpak",
            "repo",
            "web",
            "dist",
            "build-release",
            "target",
            "assets/murmel.psd",
            "murmel",
            "murmel-cli"
          ]
        }
      ]
    }
  ]
}
