[Desktop Entry]
Type=Application
Name=Murmel
Comment=Voice chat on Mumble servers
Comment[de]=Sprachchat auf Mumble-Servern
Exec=murmel
Icon=io.github.murmel.Murmel
Terminal=false
Categories=Network;InstantMessaging;
# mumble:// URL activation: GApplication remote-open (second instance) and
# org.freedesktop.Application Open (xdg-open) both prefill the connect dialog.
MimeType=x-scheme-handler/mumble;
# Activated over the session bus under the application id; xdg-mime default
# registration ships with the packaging.
DBusActivatable=true
StartupWMClass=io.github.murmel.Murmel
X-Purism=formFactor=workstation;mobile;
